#!/usr/bin/env python3
"""Keep a copy of every FC 27 card picture the site uses in /var/www/ezzcoins/card-img/, so visitors load
card pictures from ezzcoins.com instead of FUT.GG (card-img.js falls back to FUT.GG for any picture not
copied yet). Runs on the Ezzcoins server every 10 minutes (ezzcoins-cards.timer); standard library only.
A copy is named like FUT.GG's file (27-<item>.<hash>.webp), so a changed picture gets a new name.
"""
import os
import re
import time
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

SITE = Path(os.environ.get("EZZ_SITE", "/var/www/ezzcoins"))
OUT = SITE / "card-img"
CARD = re.compile(r'https://game-assets\.fut\.gg/[^"\s]*?/futgg-player-item-card/(27-\d+\.[0-9a-f]+\.webp)')
SOURCES = ("card-renders.json", "builder-items.json", "legends.json", "newcards.json")
DEADLINE = time.time() + 540          # stay inside the 10-minute slot; the next run continues
stop = False


def wanted():
    files = {}
    for name in SOURCES:
        try:
            text = (SITE / "data" / name).read_text(encoding="utf-8")
        except OSError:
            continue
        for m in CARD.finditer(text):
            files.setdefault(m.group(1), m.group(0))
    return files


def copy(item):
    global stop
    name, url = item
    if stop or time.time() > DEADLINE:
        return "skipped"
    request = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (Ezzcoins card copy)", "Accept": "image/webp,image/*;q=0.8"})
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            body = response.read()
            if not response.headers.get("Content-Type", "").startswith("image/") or len(body) < 1000:
                return "failed"
    except Exception as error:
        if getattr(error, "code", None) in (403, 429):
            stop = True                    # FUT.GG is refusing: stop now and try again next run
        return "failed"
    tmp = OUT / ("." + name + ".tmp")
    tmp.write_bytes(body)
    os.replace(tmp, OUT / name)
    time.sleep(0.05)
    return "copied"


def main():
    OUT.mkdir(parents=True, exist_ok=True)
    files = wanted()
    have = {p.name for p in OUT.iterdir() if not p.name.startswith(".")}
    todo = [(n, u) for n, u in files.items() if n not in have]
    with ThreadPoolExecutor(max_workers=4) as pool:
        results = list(pool.map(copy, todo))
    copied = results.count("copied")
    print(f"card pictures: {len(files)} used, {len(have) + copied} stored, {copied} new, "
          f"{results.count('failed')} failed, {results.count('skipped')} left for the next run")


if __name__ == "__main__":
    main()
